# Copy this file to .env for standalone real Supabase development.
# Do not commit real secrets.

# Optional. If omitted and both SUPABASE_URL + SUPABASE_ANON_KEY are present,
# Nosok v38I-2 auto-selects standaloneSupabaseDevelopment.
NOSOK_DATA_MODE=standaloneSupabaseDevelopment

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Never put SUPABASE_SERVICE_ROLE_KEY inside Flutter Web.
# Keep service_role keys only in secure server-side/admin SQL tooling.
